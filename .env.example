SETUORA_APP_MODE=lite
APP_NAME=Setuora Lite
APP_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
# The supported deployment always uses Caddy HTTPS.
SESSION_COOKIE_SECURE=true
# Setup adds the reviewed LAN hostname/address.
TRUSTED_HOSTS=127.0.0.1,localhost
# Failed-login throttle (per username).
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Docker/Caddy LAN endpoint. Setup replaces the safe loopback defaults with the
# server's reserved private address and matching LAN hostname/address.
SETUORA_LAN_BIND_ADDRESS=127.0.0.1
SETUORA_LAN_HOSTNAME=localhost
SETUORA_HTTP_PORT=80
SETUORA_HTTPS_PORT=443

# Verified automatic SQLite backups.
AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
# Editable backup scheduling/retention settings are persisted here. Compose
# fixes this to the named application data volume.
BACKUP_SETTINGS_FILE=./data/backup-settings.env
# Local-development only unless the path is explicitly mounted in Compose.
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60

# The permanent franchise code becomes part of every newly generated QR.
# Set it before generating production labels and never reuse it at another site.
FRANCHISE_CODE=

# One-off, pre-authorized, non-ephemeral key tagged tag:setuora-lite. Setup
# clears it after the persistent Tailscale identity is enrolled.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=setuora-lite
TAILSCALE_TAG=tag:setuora-lite

# Lite makes outbound requests through its Docker-internal Tailscale proxy.
# MASTER_URL is the private HTTPS URL printed by Master setup. MASTER_API_KEY is
# the separate one-time-visible Setuora node credential for this franchise.
# `deploy.py setup` fills and verifies these, then enables synchronization.
MASTER_SYNC_ENABLED=false
MASTER_URL=
MASTER_API_KEY=
MASTER_SYNC_INTERVAL_SECONDS=30
MASTER_REQUEST_TIMEOUT_SECONDS=15
MASTER_TLS_VERIFY=true
