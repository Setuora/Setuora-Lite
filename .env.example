SETUORA_APP_MODE=lite
APP_NAME=Setuora Lite
APP_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start

# Windows-native private-LAN HTTP pilot. The installer opens this port only on
# the Windows Private firewall profile.
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=127.0.0.1,localhost
SETUORA_WEB_PORT=8000

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
BACKUP_SETTINGS_FILE=./data/backup-settings.env
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60

# Permanent code enrolled in Setuora Master and used in SFTP filenames/QRs.
FRANCHISE_CODE=

# Outbound-only SFTP connection to the Master server public IP. These can be
# entered after installation from Admin -> Tally SFTP. Always pin the exact
# SHA256 host-key fingerprint supplied by the Master administrator.
SFTP_SYNC_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_HOST_KEY_SHA256=
SFTP_SYNC_INTERVAL_SECONDS=60
SFTP_CONNECT_TIMEOUT_SECONDS=15
SFTP_MAX_XML_BYTES=10485760

# Historical Node Sync remains disabled. Its previous deployment documentation
# is retained under archive/ only for data migration and audit reference.
MASTER_SYNC_ENABLED=false
