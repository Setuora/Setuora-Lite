SETUORA_APP_MODE=lite
APP_NAME=Setuora Lite
APP_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start

# Browser access is through Tailscale Serve HTTPS. The app listens on localhost
# only; staff computers must join the same tailnet.
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=127.0.0.1,localhost
SETUORA_WEB_PORT=8000
SETUORA_CADDY_PORT=8080

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
BACKUP_SETTINGS_FILE=./data/backup-settings.env
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60

# Permanent code enrolled in Setuora Master and used in QR identities.
FRANCHISE_CODE=

# Lite sends durable events to the Master node API over HTTPS. These values
# can be entered after installation from Admin -> Master connection.
MASTER_SYNC_ENABLED=false
MASTER_URL=
MASTER_API_KEY=
MASTER_SYNC_INTERVAL_SECONDS=30
MASTER_REQUEST_TIMEOUT_SECONDS=15
MASTER_TLS_VERIFY=true

# Retained only for migration from the former franchise-Tally deployment.
SFTP_SYNC_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_HOST_KEY_SHA256=
SFTP_SYNC_INTERVAL_SECONDS=60
SFTP_CONNECT_TIMEOUT_SECONDS=15
SFTP_MAX_XML_BYTES=10485760
